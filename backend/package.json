{
  "name": "lahore-property-hub-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Lahore Property Hub marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --max-old-space-size=4096 --max-semi-space-size=64 ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "seed:dev": "tsx src/scripts/seedDev.ts",
    "test:marketing": "tsx src/tests/marketingEngine.test.ts"
  },
  "keywords": [
    "real-estate",
    "property-marketplace",
    "express",
    "typescript",
    "lahore"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.4.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
