# ==============================================================================
# Lahore Property Hub — Backend Production Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://lahorepropertyhub.com
ADDITIONAL_ALLOWED_ORIGINS=https://www.lahorepropertyhub.com

# MongoDB Atlas Production Connection String
# Ensure database user has readWrite role and IP Access List allows backend server IP
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.tg48agy.mongodb.net/LahorePropertyManagement?retryWrites=true&w=majority&appName=LahorePropertyHub

# Cryptographic JWT Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_cryptographically_generated_random_secret_string

# Cloudinary Production Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production SMTP Email Configuration (e.g. Mailgun, SendGrid, Amazon SES, Google Workspace)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@lahorepropertyhub.com
SMTP_PASS=your_smtp_production_password
SMTP_FROM="Lahore Property Hub <noreply@lahorepropertyhub.com>"
ADMIN_NOTIFICATION_EMAIL=admin@lahorepropertyhub.com
